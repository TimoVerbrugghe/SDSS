#!/usr/bin/env python3
"""Launcher for the SDSS app.

Kept to a stub so the same code runs from a checkout (`app/sdss-app`) and from inside the
AppImage, where AppRun points here with the payload root on sys.path.
"""

import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1]))

from app.cli import main  # noqa: E402

if __name__ == "__main__":
    raise SystemExit(main())
